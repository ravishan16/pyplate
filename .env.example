# PyPlate FastAPI Environment Variables Example
# Copy this file to .env and adjust values as needed

# Development Environment
CONDA_ENV_NAME=fastapi-modernization # Set your local Conda environment name here

# API settings
PROJECT_NAME="PyPlate FastAPI"
PROJECT_DESCRIPTION="Modern API for Project Gutenberg books dataset"
PROJECT_VERSION="0.1.0"
API_V1_STR="/api/v1"

# CORS settings - comma-separated list of origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://localhost

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database settings - SQLite only for Phase 1
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./books.db # Updated default filename